{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
    "TrafficClassification": {
      "InternalPaths": [
        "/health",
        "/metrics"
      ],
  
      "TrustedApiKeys": [
        "partner-key-1",
        "partner-key-2"
      ],
  
      "VerifiedBotUserAgents": [
        "Googlebot",
        "Bingbot"
      ],
  
      "BlockedIps": [
        "10.10.10.10"
      ]
    },
    "RuleWeights": {
      "MissingUserAgentScore": 25,
      "SuspiciousUserAgentScore": 20,
      "MissingAcceptLanguageScore": 10,
      "MissingAcceptEncodingScore": 10,
      "RateLimitExceededScore": 40
    },
    "DetectionThresholds": {
      "AllowMax": 30,
      "ShadowMax": 50,
      "ChallengeMax": 70,
      "ThrottleMax": 90,
      "BlockMax": 100
    },
    "RateLimitOptions": {
      "RequestsPerMinute": 60
    }
}
